{
  "name": "@allibot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:visual-contract": "node --test test/visual-contract.test.ts",
    "preview": "vite preview",
    "test:strings": "node --import ./test/support/register-css.mjs --test test/strings.test.ts",
    "test:web-render": "node --import ./test/support/register-css.mjs --test test/web-render.test.ts",
    "test:agui-contract": "node --import ./test/support/register-css.mjs --test test/copilotkit-contract.test.ts",
    "test:agui-live": "node --import ./test/support/register-css.mjs --test test/copilotkit-contract.test.ts test/workspace-shell.test.ts",
    "test:task-board": "node --import ./test/support/register-css.mjs --test test/task-board.test.ts",
    "test:workspace-shell": "node --import ./test/support/register-css.mjs --test test/workspace-shell.test.ts",
    "test:agent-detail": "node --import ./test/support/register-css.mjs --test test/agent-detail.test.ts",
    "test:team-config": "node --import ./test/support/register-css.mjs --test test/team-config.test.ts"
  },
  "dependencies": {
    "@allibot/shared": "*",
    "@copilotkit/react-core": "1.83.0",
    "markdown-it": "15.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
